# Copy to backend/.env and adjust. backend/.env is ignored by Git: never commit secrets.

# development | test | production (production hides /docs)
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text | json (one JSON object per line)
LOG_FORMAT=text

# Owner role: runs migrations and loads the synthetic data (scripts/create_local_databases.sql).
DATABASE_URL=postgresql://eaa_owner:change-me@127.0.0.1:5432/eaa
# Disposable database for the -m db tests: they migrate it up and down.
TEST_DATABASE_URL=postgresql://eaa_owner:change-me@127.0.0.1:5432/eaa_test
# Reader role: the only role that runs generated SQL (scripts/create_reader_role.sql).
READER_DATABASE_URL=postgresql://eaa_reader:change-me@127.0.0.1:5432/eaa
TEST_READER_DATABASE_URL=postgresql://eaa_reader:change-me@127.0.0.1:5432/eaa_test
# Limits of every generated query (milliseconds, rows).
QUERY_TIMEOUT_MS=5000
QUERY_MAX_ROWS=1000
# API role: the audit trail only (scripts/create_roles.sql).
APP_DATABASE_URL=postgresql://eaa_app:change-me@127.0.0.1:5432/eaa
TEST_APP_DATABASE_URL=postgresql://eaa_app:change-me@127.0.0.1:5432/eaa_test

# Required in production: clients send it in the X-API-Key header.
# API_KEY=

# LLM. The model is configuration, never code; the prices are its USD per million tokens.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_ATTEMPTS=3
LLM_INPUT_PRICE_PER_MTOK=4.0
LLM_OUTPUT_PRICE_PER_MTOK=20.0
LLM_CACHE_READ_PRICE_PER_MTOK=0.2
# A checked explanation after each answer (one or two more LLM calls).
EXPLAIN_RESULTS=true
EXPLAIN_EFFORT=medium
EXPLAIN_MAX_TOKENS=4000
