# Copy to deploy/.env (ignored by Git) and fill in. Generate each password and key with:
#   openssl rand -base64 32

# The public name of the site; Caddy gets its certificate. "localhost" for a local test.
DOMAIN=localhost

# PostgreSQL superuser (only used at first start) and the three application roles.
POSTGRES_PASSWORD=
EAA_OWNER_PASSWORD=
EAA_READER_PASSWORD=
EAA_APP_PASSWORD=

# Shared by the web server and the API: the browser never sees it.
API_KEY=

# Cap on LLM spending per day (UTC), in dollars.
DAILY_BUDGET_USD=5

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Prices of LLM_MODEL, USD per million tokens, for the cost figures and the budget.
LLM_INPUT_PRICE_PER_MTOK=4.0
LLM_OUTPUT_PRICE_PER_MTOK=20.0
LLM_CACHE_READ_PRICE_PER_MTOK=0.2

ANALYSES_PER_CLIENT_PER_HOUR=20
MAX_CONCURRENT_ANALYSES=4

# small (20,000 orders) or full (100,000 orders) for the seed job.
DATASET_SCALE=small
